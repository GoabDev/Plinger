# Plinger environment template
# Copy this file to .env.local in the project root, then fill in the blank values.
# Next.js reads .env.local automatically. Restart the dev server after editing it.
# For deployment, set these values in the hosting provider's environment settings.
# This template contains no credentials. Keep real values out of this file.

# -----------------------------------------------------------------------------
# Required: site, Supabase and admin access
# -----------------------------------------------------------------------------

# Canonical origin used for GitHub sign-in redirects and personal referral links.
# Local development: http://localhost:3000
# Production: your public HTTPS origin, without a trailing slash or path.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Your Supabase project URL, e.g. https://YOUR_PROJECT_REF.supabase.co
SUPABASE_URL=

# Supabase server secret key (sb_secret_...). Used by server-side data access.
SUPABASE_SECRET_KEY=

# Supabase publishable key (sb_publishable_...). Required by the Auth integration.
SUPABASE_PUBLISHABLE_KEY=

# Legacy alternative to SUPABASE_SECRET_KEY; use only if using a service_role JWT.
# Leave SUPABASE_SECRET_KEY empty if using this alternative. Do not set both.
# SUPABASE_SERVICE_ROLE_KEY=

# Email of the confirmed Supabase Auth user allowed into the admin dashboard.
# This is an allowlist entry; create the user separately in Supabase Auth.
PLINGER_ADMIN_EMAIL=

# -----------------------------------------------------------------------------
# Required for GitHub App connections, work sync and Scouter directory access
# -----------------------------------------------------------------------------

# Numeric GitHub App ID from your GitHub App settings (not the OAuth Client ID).
GITHUB_APP_ID=

# Choose ONE private-key method below. Inline PEM is preferred for deployment.
# Option 1: full private-key PEM, quoted, with actual newlines or escaped \n.
# Example format only (replace the entire value with your actual PEM):
# GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_PEM_CONTENTS\n-----END RSA PRIVATE KEY-----"
GITHUB_PRIVATE_KEY=

# Option 2: local path to your downloaded PEM; leave the inline key empty.
# Forward slashes work on Windows, e.g. "C:/Users/HP/keys/plinger.private-key.pem".
# A local Windows path will not be available on Vercel.
GITHUB_PRIVATE_KEY_PATH=

# Required for /api/github/webhook. Set the SAME value in GitHub App settings.
# Generate a separate random secret with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
GITHUB_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Required for saving/reading Scouter personal access tokens
# -----------------------------------------------------------------------------

# Exactly 32 random bytes encoded as base64. Generate once with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Keep the existing key if tokens have already been saved. Replacing it makes
# those encrypted tokens unreadable. Use the same key for the same database.
PLINGER_PAT_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Optional: scheduled GitHub sync (manual admin sync does not require this)
# -----------------------------------------------------------------------------

# Set this in the deployed app AND the GitHub Actions repository secret named
# PLINGER_SYNC_SECRET. Generate independently from the webhook secret:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# The workflow currently calls https://plinger.vercel.app/api/github/sync;
# update .github/workflows/sync-github.yml if deploying to a different domain.
PLINGER_SYNC_SECRET=

# -----------------------------------------------------------------------------
# Optional tooling / hosting values (not needed to run the application locally)
# -----------------------------------------------------------------------------

# Browser component tests: set in your shell before npm.cmd run test:browser.
# Playwright does not automatically load .env.local.
# PowerShell: $env:PLINGER_BROWSER_CHANNEL='chrome'
# PLINGER_BROWSER_CHANNEL=chrome

# Vercel supplies this automatically. Used only as a site-metadata fallback;
# set NEXT_PUBLIC_SITE_URL explicitly for OAuth and referral links.
# VERCEL_PROJECT_PRODUCTION_URL=

# Additional setup, not environment variables:
# - Enable GitHub OAuth in Supabase Auth. Its OAuth Client ID and Client Secret
#   belong in Supabase's provider settings, not in this app's .env.local.
# - Allow your site's /auth/callback redirect in Supabase Auth URL settings.
# - Apply all supabase/migrations before using the application.
# - Configure and activate Wave 10 in Waves & referrals; wave dates live in the
#   database, so there are no WAVE_NUMBER or referral-percentage env variables.
# - Stellar verification and the exchange-rate lookup need no API keys here.
# - Supabase CLI config includes optional Studio/disabled-provider placeholders;
#   OPENAI_API_KEY, Apple/Twilio and experimental S3 settings are not app requirements.
